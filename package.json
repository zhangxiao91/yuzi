{
  "name": "yuzhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "dev:worker": "wrangler dev --port 8792",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p worker/tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.112.0"
  }
}
