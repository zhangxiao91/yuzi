{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuzi-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "yuzi-api.zx-dx.xyz", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://zx-dx.xyz,https://zxlab.pages.dev,https://*.zxlab.pages.dev,http://localhost:4321,http://127.0.0.1:4174",
    "TURNSTILE_EXPECTED_HOSTNAMES": "zx-dx.xyz,zxlab.pages.dev,beta.zxlab.pages.dev",
    "AI_GATEWAY_URL": "https://beta.zxlab.pages.dev/api/ai/generate",
    "SESSION_TTL_SECONDS": "1800"
  },
  "ratelimits": [
    { "name": "SESSION_RATE_LIMITER", "namespace_id": "42001", "simple": { "limit": 4, "period": 60 } },
    { "name": "TURN_RATE_LIMITER", "namespace_id": "42002", "simple": { "limit": 12, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "GameSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameSession"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "ZXLAB_AI_GATEWAY_TOKEN"] }
}
